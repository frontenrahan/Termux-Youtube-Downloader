#!/bin/bash
[ -z "$1" ] && echo "Usage: termux-url-opener <youtube_url>" && exit 1

for pkg in python ffmpeg ffplay; do
    command -v $pkg &>/dev/null || { pkg install -y $pkg -q 2>/dev/null || pkg install -y $pkg; }
done
command -v yt-dlp &>/dev/null || { pip install -q yt-dlp 2>/dev/null || pip install yt-dlp; }

clean_url=$(echo "$1" | sed 's/?si=.*$//' | sed 's/&si=.*$//')
DOWNLOAD_DIR="/storage/emulated/0/Download"
mkdir -p "$DOWNLOAD_DIR" 2>/dev/null

echo ""
echo "AVAILABLE FORMATS"
echo "─────────────────"

video_data=$(yt-dlp -F --no-warnings "$clean_url" 2>/dev/null | awk '
    /^[0-9]+/ && !/audio only/ {
        id=$1; type=$2; res=""; size=""; has_audio=0
        for(i=1;i<=NF;i++){
            if($i ~ /[0-9]+x[0-9]+/) res=$i
            if($i ~ /[0-9.]+[KM]iB$/) size=$i
            if($i ~ /mp4a|opus|aac/) has_audio=1
        }
        if(res && size){
            if(!(res in res_order)){
                res_order[res] = ++idx
                res_list[idx] = res
            }
            res_formats[res] = res_formats[res] (res_formats[res] ? "|" : "") id "|" type "|" size "|" has_audio
        }
    }
    END {
        for(i=1;i<=idx;i++){
            res = res_list[i]
            split(res_formats[res], formats, "|")
            has_mp4 = 0
            for(j=1;j<=length(formats);j+=4){
                if(formats[j+1] == "mp4") { has_mp4 = 1; break }
            }
            if(has_mp4){
                for(j=1;j<=length(formats);j+=4){
                    if(formats[j+1] == "mp4"){
                        print "V|" formats[j] "|" formats[j+1] "|" res "|" formats[j+2] "|" formats[j+3]
                    }
                }
            } else {
                for(j=1;j<=length(formats);j+=4){
                    print "V|" formats[j] "|" formats[j+1] "|" res "|" formats[j+2] "|" formats[j+3]
                }
            }
        }
    }
')

audio_data=$(yt-dlp -F --no-warnings "$clean_url" 2>/dev/null | awk '
    /audio only/ {
        id=$1; type=$2; bit=""; size=""
        split($0, a, "|")
        gsub(/^[ \t]+|[ \t]+$/, "", a[2])
        split(a[2], b, " ")
        if(length(b)>=2 && b[2] ~ /[0-9]+k/){
            bit=b[2]
            size=b[1]
        }
        if(bit && size) print "A|" id "|" type "|" bit "|" size
    }
')

video_codes=(); video_type=(); video_res=(); video_size=(); video_has_audio=()
while IFS='|' read -r category id type res size has_audio; do
    [ "$category" = "V" ] && { video_codes+=("$id"); video_type+=("$type"); video_res+=("$res"); video_size+=("$size"); video_has_audio+=("$has_audio"); }
done <<< "$video_data"

audio_codes=(); audio_type=(); audio_bit=(); audio_size=()
while IFS='|' read -r category id type qual size; do
    [ "$category" = "A" ] && { audio_codes+=("$id"); audio_type+=("$type"); audio_bit+=("$qual"); audio_size+=("$size"); }
done <<< "$audio_data"

video_count=${#video_codes[@]}
audio_count=${#audio_codes[@]}

printf "\nVIDEO\n"
for i in "${!video_codes[@]}"; do
    printf "  %2d.  %-9s %-9s %s\n" $((i+1)) "${video_res[$i]}" "${video_size[$i]}" "${video_type[$i]}"
done

printf "\nAUDIO\n"
for i in "${!audio_codes[@]}"; do
    printf "  %2d.  %-9s %-9s %s\n" $((i+video_count+1)) "${audio_bit[$i]}" "${audio_size[$i]}" "${audio_type[$i]}"
done

echo ""
read -p "Select [7]: " choice
[ -z "$choice" ] && choice=7

if [ "$choice" -le "$video_count" ]; then
    idx=$((choice-1))
    format_code="${video_codes[$idx]}"
    is_audio="no"
    qual="${video_res[$idx]}"
    size="${video_size[$idx]}"
    type="${video_type[$idx]}"
    has_audio="${video_has_audio[$idx]}"
    qual_clean=$(echo "$qual" | sed 's/x/_/')
else
    idx=$((choice - video_count - 1))
    [ "$idx" -ge 0 ] && [ "$idx" -lt "$audio_count" ] || { echo "Invalid selection. Exiting."; exit 1; }
    format_code="${audio_codes[$idx]}"
    is_audio="yes"
    qual="${audio_bit[$idx]}"
    size="${audio_size[$idx]}"
    type="${audio_type[$idx]}"
    qual_clean=$(echo "$qual" | sed 's/k//')
fi

[ -z "$format_code" ] && echo "Invalid selection. Exiting." && exit 1

title=$(yt-dlp --print "%(title)s" --no-warnings "$clean_url" 2>/dev/null)
[ -z "$title" ] && title="download_$(date +%s)"
safe_title=$(echo "$title" | sed 's/[^a-zA-Z0-9._-]/_/g' | sed 's/__*/_/g' | sed 's/^_//;s/_$//')

if [ "$is_audio" == "yes" ]; then
    filename="${safe_title}_${qual_clean}k.mp3"
    full_path="$DOWNLOAD_DIR/music/$filename"
    mkdir -p "$DOWNLOAD_DIR/music" 2>/dev/null
    echo ""
    echo "[>>] Audio: $filename ($qual - $size)"
    error_output=$(yt-dlp --no-mtime -f "$format_code" -o "$full_path" -x --audio-format mp3 --audio-quality "${qual_clean}k" --embed-thumbnail --add-metadata --metadata-from-title "%(title)s" --windows-filenames --restrict-filenames --force-overwrites --no-cache-dir --sleep-requests 2 --sleep-interval 3 "$clean_url" 2>&1)
    if [ $? -ne 0 ]; then
        echo "Download failed!"
        echo ""
        echo "Full error log:"
        echo "$error_output"
        exit 1
    fi
else
    if [ "$has_audio" -eq 0 ]; then
        while true; do
            echo ""
            echo "Available audio formats for merging:"
            for i in "${!audio_codes[@]}"; do
                printf "  %2d.  %-9s %-9s %s\n" $((i+video_count+1)) "${audio_bit[$i]}" "${audio_size[$i]}" "${audio_type[$i]}"
            done
            echo ""
            default_audio=$((video_count+1))
            read -p "Select audio format [${default_audio}]: " audio_choice
            if [ -z "$audio_choice" ]; then
                audio_choice=$default_audio
            fi
            audio_idx=$((audio_choice - video_count - 1))
            if [ "$audio_idx" -ge 0 ] && [ "$audio_idx" -lt "$audio_count" ]; then
                audio_format_code="${audio_codes[$audio_idx]}"
                audio_qual="${audio_bit[$audio_idx]}"
                audio_size="${audio_size[$audio_idx]}"
                audio_type="${audio_type[$audio_idx]}"
                break
            else
                echo "Invalid selection. Please choose a valid number from the list."
            fi
        done

        if [ -n "$audio_format_code" ]; then
            filename="${safe_title}_${qual_clean}.mp4"
            full_path="$DOWNLOAD_DIR/videos/$filename"
            mkdir -p "$DOWNLOAD_DIR/videos" 2>/dev/null
            echo ""
            echo "[>>] Video: $filename ($qual - $size) [with audio from ${audio_qual}]"
            error_output=$(yt-dlp --no-mtime -f "$format_code+$audio_format_code" -o "$full_path" --merge-output-format mp4 --embed-thumbnail --add-metadata --windows-filenames --restrict-filenames --force-overwrites --no-cache-dir --sleep-requests 2 --sleep-interval 3 "$clean_url" 2>&1)
            if [ $? -ne 0 ]; then
                echo "Download failed!"
                echo ""
                echo "Full error log:"
                echo "$error_output"
                exit 1
            fi
            merged=1
        fi
    fi

    if [ -z "$merged" ]; then
        filename="${safe_title}_${qual_clean}.mp4"
        full_path="$DOWNLOAD_DIR/videos/$filename"
        mkdir -p "$DOWNLOAD_DIR/videos" 2>/dev/null
        echo ""
        echo "[>>] Video: $filename ($qual - $size)"
        if [ "$type" = "webm" ]; then
            temp_file="$DOWNLOAD_DIR/videos/temp_${safe_title}.webm"
            error_output=$(yt-dlp --no-mtime -f "$format_code" -o "$temp_file" --embed-thumbnail --add-metadata --windows-filenames --restrict-filenames --force-overwrites --no-cache-dir --sleep-requests 2 --sleep-interval 3 "$clean_url" 2>&1)
            if [ $? -ne 0 ]; then
                echo "Download failed!"
                echo ""
                echo "Full error log:"
                echo "$error_output"
                exit 1
            fi
            [ -f "$temp_file" ] && {
                ffmpeg -i "$temp_file" -c:v libx264 -c:a aac -movflags +faststart "$full_path" -y 2>/dev/null
                rm -f "$temp_file"
                yt-dlp --no-mtime --write-thumbnail --convert-thumbnails png --skip-download -o "$full_path" "$clean_url" &>/dev/null
            } || { echo "Conversion failed!"; exit 1; }
        else
            error_output=$(yt-dlp --no-mtime -f "$format_code" -o "$full_path" --embed-thumbnail --add-metadata --windows-filenames --restrict-filenames --force-overwrites --no-cache-dir --sleep-requests 2 --sleep-interval 3 "$clean_url" 2>&1)
            if [ $? -ne 0 ]; then
                echo "Download failed!"
                echo ""
                echo "Full error log:"
                echo "$error_output"
                exit 1
            fi
        fi
    fi
fi

[ ! -f "$full_path" ] && echo "No file found." && exit 1

filename=$(basename "$full_path")
filesize=$(du -h "$full_path" | cut -f1)
duration=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$full_path" 2>/dev/null)
duration=${duration%.*}
[ -z "$duration" ] && duration=0
dur_min=$((duration / 60))
dur_sec=$((duration % 60))

echo ""
echo "File: $full_path"
echo "Size: $filesize"
echo "Duration: $(printf "%02d:%02d" $dur_min $dur_sec)"
echo ""

if [[ "$full_path" == *.mp3 ]]; then
    echo "Options:"
    echo "  1) Play in Termux (ffplay) (default)"
    echo "  2) Play with external player"
    echo "  3) Exit"
    echo ""
    read -p "Select option (1-3) [1]: " choice_play
    choice_play=${choice_play:-1}
    case $choice_play in
        1)
            ffplay -nodisp -autoexit -loglevel quiet "$full_path" 2>/dev/null &
            PLAY_PID=$!
            elapsed=0
            trap 'echo -e "\nExiting..."; exit 0' INT
            while kill -0 $PLAY_PID 2>/dev/null; do
                [ $duration -gt 0 ] && {
                    percent=$((elapsed * 100 / duration))
                    [ $percent -gt 100 ] && percent=100
                    filled=$((percent * 30 / 100))
                    empty=$((30 - filled))
                    elapsed_min=$((elapsed / 60))
                    elapsed_sec=$((elapsed % 60))
                    printf "\r[%s%s] %5.1f%% %02d:%02d / %02d:%02d" \
                        "$(printf '%*s' $filled | tr ' ' '#')" \
                        "$(printf '%*s' $empty | tr ' ' '-')" \
                        "$percent" "$elapsed_min" "$elapsed_sec" "$dur_min" "$dur_sec"
                }
                sleep 1
                elapsed=$((elapsed + 1))
            done
            echo -e "\nPlayback finished"
            ;;
        2) am start -a android.intent.action.VIEW -d "file://$full_path" -t audio/mpeg >/dev/null 2>&1 ;;
        3) echo "Exiting..." && exit 0 ;;
        *) echo "Invalid option" ;;
    esac
else
    echo "Options:"
    echo "  1) Play with external player (default)"
    echo "  2) Exit"
    echo ""
    read -p "Select option (1-2) [1]: " choice_play
    choice_play=${choice_play:-1}
    case $choice_play in
        1) am start -a android.intent.action.VIEW -d "file://$full_path" -t video/mp4 >/dev/null 2>&1 ;;
        2) echo "Exiting..." && exit 0 ;;
        *) echo "Invalid option" ;;
    esac
fi
